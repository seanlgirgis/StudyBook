# StudyBook Infra Environment Template
# Copy this file to .env.local (gitignored) and fill real values.

# Core data services
POSTGRES_USER=de_admin
POSTGRES_PASSWORD=change_me
POSTGRES_DB=de_telemetry
POSTGRES_PORT=5432

REDIS_PASSWORD=change_me
REDIS_PORT=6380

CASSANDRA_PORT=9042

NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

INFLUXDB_USER=de_admin
INFLUXDB_PASSWORD=change_me
INFLUXDB_ORG=de_org
INFLUXDB_BUCKET=telemetry
INFLUXDB_TOKEN=change_me
INFLUXDB_PORT=8086

ELASTIC_PASSWORD=change_me
ELASTIC_PORT=9200
KIBANA_PASSWORD=change_me
KIBANA_PORT=5601

# Streaming + pipeline
KAFKA_PORT=9092
KAFKA_INTERNAL_PORT=29092
ZOOKEEPER_PORT=2181
KAFKA_UI_PORT=8080

SPARK_MASTER_UI_PORT=8081
SPARK_MASTER_PORT=7077
SPARK_WORKER_UI_PORT=8085
SPARK_JARS_HOST_PATH=C:/Users/shareuser/.ivy2/jars

AIRFLOW_PORT=8082
AIRFLOW_USER=airflow
AIRFLOW_PASSWORD=airflow

MLFLOW_PORT=5000

# Observability
SPLUNK_PASSWORD=change_me
SPLUNK_PORT_WEB=8000
SPLUNK_PORT_HEC=8088
SPLUNK_PORT_MGT=8089

# Optional seeds
SEED_CORE=42
SEED_TECH=42
SEED_ENDPOINTS=10000
SEED_METRICS=500000
SEED_ALERTS=25000
SEED_EVENTS=50000

# External managed services
AWS_PROFILE=study
AWS_DEFAULT_REGION=us-east-1
AWS_SHARED_CREDENTIALS_FILE=
AWS_CONFIG_FILE=

AZURE_TENANT_ID=
AZURE_SUBSCRIPTION_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_RESOURCE_GROUP=

DATABRICKS_HOST=
DATABRICKS_TOKEN=

MONGODB_URI=replace_me
MONGODB_HOST=replace_me
MONGODB_USER=replace_me
MONGODB_PASSWORD=replace_me
MONGODB_DATABASE=de_telemetry
