# ============================================================
# Topic   : Docker for Data Engineers
# File    : Dockerfile.multistage
# Covers  : Multi-stage build: builder dependencies separated from runtime image
# Prereqs : Docker Desktop installed and running
# Run     : docker build --target runtime -f Dockerfile.multistage -t tutorial36-pipeline:multistage-1.0.0 .
# ============================================================

# Stage 1: Builder — install build tools and Python packages into /install.
# Why: compilers and headers are useful while building dependencies, but they make
# the runtime image larger and increase the attack surface if left in production.
FROM python:3.11.9-slim-bookworm AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /build

# Why: --no-install-recommends avoids optional packages; removing apt lists keeps
# this builder layer smaller. Builder size matters less than runtime size, but fast
# builds still help developer feedback loops.
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Why: copy requirements first so dependency installation is cached unless
# requirements.txt changes.
COPY requirements.txt .

# Why: install to a dedicated prefix so the runtime stage can copy only the final
# Python packages, not compilers, apt metadata, or build caches.
RUN pip install --no-cache-dir --prefix=/install -r requirements.txt


# Stage 2: Runtime — small production image with app code and installed packages.
# Why: this stage is what ships. The builder stage is discarded.
FROM python:3.11.9-slim-bookworm AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    APP_VERSION=1.0.0

WORKDIR /app

# Why: copy ONLY installed packages from builder. Build tools do not land here.
COPY --from=builder /install /usr/local

# Why: app code changes should not invalidate dependency layers.
COPY app/ ./app/

# Why: non-root user reduces damage if the container process is compromised.
RUN groupadd --gid 1001 appgroup && \
    useradd --uid 1001 --gid appgroup --shell /usr/sbin/nologin --create-home appuser && \
    chown -R appuser:appgroup /app

USER appuser

# Why: health checks let Compose/orchestrators detect whether the container can
# start Python successfully.
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD python -c "import sys; sys.exit(0)"

CMD ["python", "app/pipeline.py"]
