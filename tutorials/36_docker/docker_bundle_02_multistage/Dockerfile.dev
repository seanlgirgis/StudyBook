# ============================================================
# Topic   : Docker for Data Engineers
# File    : Dockerfile.dev
# Covers  : Development image with test/debug tooling and bind-mounted source
# Prereqs : Docker Desktop installed and running
# Run     : docker build -f Dockerfile.dev -t tutorial36-pipeline:dev-1.0.0 .
# ============================================================

# Development image: includes developer tools. This is intentionally separate from
# the production runtime image so debug/test packages do not ship to production.
FROM python:3.11.9-slim-bookworm AS dev

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

# Why: install runtime dependencies first for cache efficiency.
COPY requirements.txt .

# Why: install small dev tools explicitly. They are useful locally but should stay
# out of the production Dockerfile.
RUN pip install --no-cache-dir -r requirements.txt \
    pytest==8.2.2 \
    debugpy==1.8.2

# Why: create a non-root dev user too. Dev containers can still touch mounted
# files, but they should not run as root by default.
RUN groupadd --gid 1001 appgroup && \
    useradd --uid 1001 --gid appgroup --shell /bin/bash --create-home appuser && \
    chown -R appuser:appgroup /app

USER appuser

# Dev image expects app code to be bind-mounted:
#   docker run --rm -v ${PWD}/app:/app/app:ro tutorial36-pipeline:dev-1.0.0
CMD ["python", "app/pipeline.py"]
