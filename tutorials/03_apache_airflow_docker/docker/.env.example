# Copy this file to .env before first run.

COMPOSE_PROJECT_NAME=docker_airflow
AIRFLOW_IMAGE_NAME=apache/airflow:2.10.5
AIRFLOW_UID=50000
AIRFLOW_GID=0
AIRFLOW_PROJECT_DIR=.

# Airflow metadata DB and broker defaults
_POSTGRES_USER=airflow
_POSTGRES_PASSWORD=airflow
_POSTGRES_DB=airflow

# Web UI bootstrap user
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin
_AIRFLOW_WWW_USER_FIRSTNAME=Study
_AIRFLOW_WWW_USER_LASTNAME=Book
_AIRFLOW_WWW_USER_EMAIL=admin@example.com

# Optional additional Python packages
_PIP_ADDITIONAL_REQUIREMENTS=
